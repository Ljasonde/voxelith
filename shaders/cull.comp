#version 460
layout(local_size_x=64) in;
struct Chunk {vec4 lo,hi;uvec4 draw;};
struct Cmd {uint count,instanceCount,firstIndex;int vertexOffset;uint firstInstance;};
layout(std430,binding=0) readonly buffer Metadata {Chunk chunks[];};
layout(std430,binding=1) writeonly buffer Output {Cmd draws[];};
layout(std430,binding=2) buffer Counter {uint visible,triangles;};
layout(push_constant) uniform Params {mat4 vp; vec4 eye; uvec4 num;} p;
void main(){
 uint i=gl_GlobalInvocationID.x;if(i>=p.num.x)return;
 Chunk c=chunks[i];if(distance(p.eye.xyz,clamp(p.eye.xyz,c.lo.xyz,c.hi.xyz))>p.eye.w)return;
 uint mask=63;
 for(int v=0;v<8;v++){vec4 q=p.vp*vec4(mix(c.lo.xyz,c.hi.xyz,bvec3((v&1)!=0,(v&2)!=0,(v&4)!=0)),1);
  uint m=uint(q.x < -q.w) | (uint(q.x>q.w)<<1) | (uint(q.y < -q.w)<<2) | (uint(q.y>q.w)<<3) | (uint(q.z<0)<<4) | (uint(q.z>q.w)<<5);
  mask &= m;}
 if(mask!=0)return;
 uint dst=atomicAdd(visible,1);atomicAdd(triangles,c.draw.x/3);
 draws[dst]=Cmd(c.draw.x,1,c.draw.y,int(c.draw.z),0);
}
